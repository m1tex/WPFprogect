<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="👻 СТРАШНАЯ ИСТОРИЯ 👻" 
                   FontSize="28" FontWeight="Bold" Foreground="#FF8B0000"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="Courier New"/>

        <!-- Кнопка -->
        <Button x:Name="KnockButton" Grid.Row="1" Content="Тук-тук" 
                Width="200" Height="70" FontSize="24" FontWeight="Bold"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FF3D3D3D" Foreground="#FFE0E0E0"
                BorderBrush="#FF8B0000" BorderThickness="3"
                Click="KnockButton_Click">
            <Button.Triggers>
                <EventTrigger RoutedEvent="Button.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="220" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height" To="80" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Button.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="200" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height" To="70" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Страшные узоры -->
        <TextBlock Grid.Row="2" Text="🎃 🕸️ 🦇 🕷️ 🎃" 
                   FontSize="18" Foreground="#FF5A5A5A"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</Window>
